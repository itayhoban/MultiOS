<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multios</groupId>
        <artifactId>multios</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>multios-ui</artifactId>
    <name>MultiOs UI</name>
    <description>JavaFX desktop shell</description>

    <dependencies>
        <dependency>
            <groupId>com.multios</groupId>
            <artifactId>multios-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.multios</groupId>
            <artifactId>multios-core</artifactId>
        </dependency>

        <!-- Runtime plugins must be on the classpath so ServiceLoader can discover them. -->
        <dependency>
            <groupId>com.multios</groupId>
            <artifactId>plugin-win-native</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.multios</groupId>
            <artifactId>plugin-java-multi</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <!--
                      CLASSPATH + dedicated launcher avoids Windows module-path issues
                      when JavaFX is not on the JDK module path.
                    -->
                    <runtimePathOption>CLASSPATH</runtimePathOption>
                    <mainClass>com.multios.ui.MultiOsLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
